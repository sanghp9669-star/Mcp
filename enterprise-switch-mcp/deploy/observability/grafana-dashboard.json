{
  "title": "Enterprise Switch MCP Server - NOC & Security Telemetry",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "MCP Tool Calls / sec",
      "targets": [{ "expr": "sum(rate(switch_mcp_tool_calls_total[5m]))" }],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AI Guardrail Blocks (24h)",
      "targets": [{ "expr": "sum(increase(switch_mcp_guardrail_blocks_total[24h]))" }],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "MCP Tool p95 Execution Latency (s)",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(switch_mcp_tool_duration_seconds_bucket[5m])) by (le, vendor))" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active Switch SSH Sessions by Vendor",
      "targets": [{ "expr": "switch_mcp_active_ssh_sessions" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    }
  ]
}
