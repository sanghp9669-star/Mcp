# ==============================================================================
# Enterprise Switch MCP Server - Environment Configuration Template
# Copy to .env and populate via Secrets Manager / HashiCorp Vault in production.
# ==============================================================================

APP_ENV=production
APP_NAME=enterprise-switch-mcp
APP_HOST=0.0.0.0
APP_PORT=8080
MCP_TRANSPORT=streamable-http
LOG_LEVEL=INFO

# --- Authentication & OAuth2 / JWT ---
JWT_ALGORITHM=RS256
JWT_ISSUER=https://sso.enterprise.internal/realms/netops
JWT_AUDIENCE=enterprise-switch-mcp
OIDC_JWKS_URL=https://sso.enterprise.internal/realms/netops/protocol/openid-connect/certs
# Used only when JWT_ALGORITHM=HS256 in local isolated development
JWT_SECRET_KEY=
MFA_ISSUER_NAME=NetGuard-Switch-MCP

# --- PostgreSQL (Primary & Read Replica) ---
POSTGRES_DSN=postgresql+asyncpg://mcp_app:CHANGE_ME@postgres-primary:5432/switch_mcp
POSTGRES_READ_DSN=postgresql+asyncpg://mcp_readonly:CHANGE_ME@postgres-replica:5432/switch_mcp
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_SSL_MODE=require

# --- Redis Sentinel / Cluster ---
REDIS_MODE=sentinel
REDIS_SENTINEL_NODES=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_SENTINEL_MASTER=mymaster
REDIS_URL=redis://:CHANGE_ME@redis-master:6379/0
REDIS_PASSWORD=
REDIS_LOCK_TTL_SECONDS=45

# --- RabbitMQ Cluster ---
RABBITMQ_URL=amqp://mcp_worker:CHANGE_ME@rabbitmq-1:5672,rabbitmq-2:5672/netops
RABBITMQ_EXCHANGE=switch_mcp.events

# --- HashiCorp Vault ---
VAULT_ADDR=https://vault.enterprise.internal:8200
VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_TOKEN=
VAULT_MOUNT_KV=secret
VAULT_SWITCH_CREDS_PREFIX=network/switches

# --- Network SSH / Transport ---
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=60
SSH_KNOWN_HOSTS_PATH=/etc/switch_mcp/known_hosts
SSH_STRICT_HOST_KEY_CHECKING=true
MAX_CONCURRENT_SSH_SESSIONS=50

# --- Observability (OpenTelemetry / Prometheus / OpenSearch) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=enterprise-switch-mcp
PROMETHEUS_ENABLED=true
OPENSEARCH_URL=https://opensearch-cluster:9200
OPENSEARCH_INDEX_PREFIX=switch-mcp-audit
